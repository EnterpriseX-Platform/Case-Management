<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:cm="http://enterprisex.io/schema/cm/1.0" id="defs_purchase_request" targetNamespace="http://enterprisex.io/cm/packs">
  <process id="purchase_request" name="คำขอจัดซื้อ" isExecutable="true">
    <startEvent id="start" name="เริ่มคำขอจัดซื้อ"></startEvent>
    <userTask id="request" name="จัดทำคำขอจัดซื้อ" cm:role="requester" cm:form="purchase-request" cm:sla="P3D"></userTask>
    <userTask id="review" name="หน่วยงานที่เกี่ยวข้องให้ความเห็น" cm:role="reviewer" cm:form="opinion-form" cm:sla="P5D"><multiInstanceLoopCharacteristics cm:collection="reviewers" cm:elementVariable="reviewer"/></userTask>
    <boundaryEvent id="review_reminder" name="ใกล้ครบกำหนดให้ความเห็น" attachedToRef="review" cancelActivity="false"><timerEventDefinition><timeDuration>P4D</timeDuration></timerEventDefinition></boundaryEvent>
    <userTask id="follow_up" name="ติดตามความเห็นที่ยังไม่ได้รับ" cm:role="requester" cm:form="note-form" cm:sla="P1D"></userTask>
    <endEvent id="follow_end" name=""></endEvent>
    <userTask id="approve" name="พิจารณาอนุมัติคำขอ" cm:role="approver" cm:form="approval-form" cm:sla="P3D"></userTask>
    <businessRuleTask id="limit_check" name="ตรวจวงเงินตามอำนาจอนุมัติ" cm:role="" cm:rule="approval-limit-check"></businessRuleTask>
    <exclusiveGateway id="gw_limit" name="อยู่ในวงเงิน?" default="f_over"></exclusiveGateway>
    <userTask id="revise" name="ปรับปรุงคำขอ" cm:role="requester" cm:form="approval-form" cm:sla="P2D"></userTask>
    <userTask id="purchase" name="ดำเนินการจัดซื้อ" cm:role="procurement" cm:form="purchase-order" cm:sla="P14D"></userTask>
    <userTask id="receive" name="ตรวจรับพัสดุ" cm:role="requester" cm:form="receive-form" cm:sla="P7D"></userTask>
    <manualTask id="accounting" name="บันทึกบัญชี" cm:role="finance" cm:form="accounting-form"></manualTask>
    <endEvent id="end" name="ปิดคำขอ"></endEvent>
    <sequenceFlow id="f1" sourceRef="start" targetRef="request"/>
    <sequenceFlow id="f2" sourceRef="request" targetRef="review"/>
    <sequenceFlow id="f3" sourceRef="review" targetRef="approve"/>
    <sequenceFlow id="f4" sourceRef="approve" targetRef="limit_check"/>
    <sequenceFlow id="f5" sourceRef="limit_check" targetRef="gw_limit"/>
    <sequenceFlow id="f_ok" sourceRef="gw_limit" targetRef="purchase"><conditionExpression>${withinLimit == true}</conditionExpression></sequenceFlow>
    <sequenceFlow id="f_over" sourceRef="gw_limit" targetRef="revise"/>
    <sequenceFlow id="f6" sourceRef="revise" targetRef="limit_check"/>
    <sequenceFlow id="f7" sourceRef="purchase" targetRef="receive"/>
    <sequenceFlow id="f8" sourceRef="receive" targetRef="accounting"/>
    <sequenceFlow id="f9" sourceRef="accounting" targetRef="end"/>
    <sequenceFlow id="f10" sourceRef="review_reminder" targetRef="follow_up"/>
    <sequenceFlow id="f11" sourceRef="follow_up" targetRef="follow_end"/>
  </process>
  <bpmndi:BPMNDiagram id="dia_purchase_request"><bpmndi:BPMNPlane id="plane_purchase_request" bpmnElement="purchase_request">
    <bpmndi:BPMNShape id="start_di" bpmnElement="start"><dc:Bounds x="42" y="122" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="request_di" bpmnElement="request"><dc:Bounds x="170" y="100" width="120" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="review_di" bpmnElement="review"><dc:Bounds x="340" y="100" width="120" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="review_reminder_di" bpmnElement="review_reminder"><dc:Bounds x="420" y="162" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="follow_up_di" bpmnElement="follow_up"><dc:Bounds x="380" y="300" width="120" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="follow_end_di" bpmnElement="follow_end"><dc:Bounds x="592" y="322" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="approve_di" bpmnElement="approve"><dc:Bounds x="510" y="100" width="120" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="limit_check_di" bpmnElement="limit_check"><dc:Bounds x="680" y="100" width="120" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="gw_limit_di" bpmnElement="gw_limit" isMarkerVisible="true"><dc:Bounds x="885" y="115" width="50" height="50"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="revise_di" bpmnElement="revise"><dc:Bounds x="850" y="300" width="120" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="purchase_di" bpmnElement="purchase"><dc:Bounds x="1020" y="100" width="120" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="receive_di" bpmnElement="receive"><dc:Bounds x="1190" y="100" width="120" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="accounting_di" bpmnElement="accounting"><dc:Bounds x="1360" y="100" width="120" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="end_di" bpmnElement="end"><dc:Bounds x="1572" y="122" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1"><di:waypoint x="78" y="140"/><di:waypoint x="170" y="140"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2"><di:waypoint x="290" y="140"/><di:waypoint x="340" y="140"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3"><di:waypoint x="460" y="140"/><di:waypoint x="510" y="140"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4"><di:waypoint x="630" y="140"/><di:waypoint x="680" y="140"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="f5_di" bpmnElement="f5"><di:waypoint x="800" y="140"/><di:waypoint x="885" y="140"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="f_ok_di" bpmnElement="f_ok"><di:waypoint x="935" y="140"/><di:waypoint x="1020" y="140"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="f_over_di" bpmnElement="f_over"><di:waypoint x="910" y="165"/><di:waypoint x="910" y="420"/><di:waypoint x="910" y="420"/><di:waypoint x="910" y="380"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="f6_di" bpmnElement="f6"><di:waypoint x="910" y="380"/><di:waypoint x="910" y="420"/><di:waypoint x="740" y="420"/><di:waypoint x="740" y="180"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="f7_di" bpmnElement="f7"><di:waypoint x="1140" y="140"/><di:waypoint x="1190" y="140"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="f8_di" bpmnElement="f8"><di:waypoint x="1310" y="140"/><di:waypoint x="1360" y="140"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="f9_di" bpmnElement="f9"><di:waypoint x="1480" y="140"/><di:waypoint x="1572" y="140"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="f10_di" bpmnElement="f10"><di:waypoint x="438" y="198"/><di:waypoint x="438" y="420"/><di:waypoint x="440" y="420"/><di:waypoint x="440" y="380"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="f11_di" bpmnElement="f11"><di:waypoint x="500" y="340"/><di:waypoint x="592" y="340"/></bpmndi:BPMNEdge>
  </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</definitions>
